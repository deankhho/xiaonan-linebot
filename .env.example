# .env.example — 複製為 .env，填入真實值
# 部署時設為平台環境變數（Render / Railway / Heroku）

# LINE Bot
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google（Service Account JSON 檔案路徑）
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
SPREADSHEET_ID=
SHEET_NAME=記錄
DRIVE_FOLDER_ID=

# 本地目錄（可不設，使用預設值）
BACKUP_DIR=backup
QUEUE_DIR=queue
TEMP_DIR=temp
DEADLETTER_DIR=deadletter
