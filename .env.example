# .env.example — 複製為 .env，填入真實值
# 部署時設為 Render 環境變數（Settings → Environment）

# LINE Bot
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google Service Account
# Render Secret Files 掛載路徑為 /etc/secrets/<filename>
# 上傳 service_account.json 後，此處填入完整路徑
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/secrets/service_account.json
SPREADSHEET_ID=
DRIVE_FOLDER_ID=

# Gemini AI
GEMINI_API_KEY=
