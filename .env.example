# .env.example — 複製為 .env，填入真實值
# 部署時設為 Render 環境變數（Settings → Environment）

# LINE Bot
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google（Service Account JSON 用 Render Secret Files 上傳）
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
SPREADSHEET_ID=
DRIVE_FOLDER_ID=

# Gemini AI
GEMINI_API_KEY=
